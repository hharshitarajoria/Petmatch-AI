{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases
       NOTE: no "baseUrl" here on purpose — it's deprecated in TS 6 and
       removed in TS 7 (TS5101 if set). Instead, every path value below
       starts with "./", which satisfies TS5090 ("non-relative paths are
       not allowed when 'baseUrl' is not set") without needing baseUrl.
       If a value here is ever changed to a bare "src/*" (no leading
       "./"), TS5090 comes back — always keep the leading "./". */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
